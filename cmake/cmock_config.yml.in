:cmock:
  :mock_prefix: Mock
  :mock_path: '@CMOCK_GEN_DIR@'
  :verbosity: 2
  :strippables:
    - 'SYSCALL'
    - 'SUDOCALL'
    - 'TASKSWITCH'
    - '__attribute__\(\([^)]*\)\)'
    - 'DEPRECATED'
    - 'WARN_UNUSED_RESULT'
    - 'WEAK'
    - 'void io_seproxyhal_display\([^)]*\);'
    - 'NORETURN'
  :plugins:
    - :ignore
    - :expect_any_args
    - :callback
  # Function types: compare the pointers, not sizeof(function) bytes of code
  :treat_as:
    'tlv_handler_cb_t*': 'PTR'
    'tag_to_flag_function_t*': 'PTR'
